---
import Footer from "../components/Footer"
import Navbar from "../components/Navbar"
import { metadata_appName, metadata_featureImageAlt, metadata_pages, metadata_slugs } from "../text/text_metadata"
import type { Language } from "../types/types_global"
import Layout_Base from "./Layout_Base.astro"
import favicon16 from "../assets/icon/favicon-16x16.png"
import favicon32 from "../assets/icon/favicon-32x32.png"
import appleTouchIcon from "../assets/icon/apple-touch-icon.png"
import "../styles/styles.css"
import type { MetaPage } from "../text/text_metadata"

interface Props{
	language: Language
    path?: string
}

let userRatingCount, averageUserRating;
try {
    const res = await fetch("https://itunes.apple.com/lookup?id=6670214648&country=ch");
    if (res.ok) ({ userRatingCount, averageUserRating } = (await res.json()).results?.[0] ?? {});
} catch {}

const { language, path = "" } = Astro.props;

const locales = { 
	de: "de_DE", 
	en: "en_US", 
	fr: "fr_FR",
    it: "it_IT"
}

const ogLocale = locales[language] ?? "en_US"

const ogAlternates = Object.values(locales).filter(locale => locale !== ogLocale)

const baseURL = `https://arsenal-app.ch/`
const pageURL = `${baseURL}${language}/${path}`

const cleanPath = path.replace(/\/$/, "")

const knownKey = (Object.keys(metadata_slugs) as MetaPage[])
    .find(key => metadata_slugs[key][language] === cleanPath)

if (!knownKey && import.meta.env.DEV) {
    console.warn(`[Layout] Unknown path "${path}" for language "${language}"; check metadata_slugs`)
}

const pageKey: MetaPage = knownKey ?? "home"
const meta = metadata_pages[pageKey] ?? metadata_pages.home
const pageTitle = meta.title[language]
const pageDescription = meta.description[language]

const isHome = cleanPath === ""
const noindex = pageKey === "privacy" || pageKey === "imprint"
const languagesList = Object.keys(locales) as Language[]

const softwareJsonLd = {
                "@context": "https://schema.org",
                "@type": "SoftwareApplication",
                "name": metadata_appName[language],
                "alternateName": [
                    "Arsenal Gun Collection",
                    "Arsenal Waffen & Sammlung",
                    "Arsenal Collection d'Armes",
                    "Arsenal Collezione d'Armi"
                ],
                "operatingSystem": "Android, iOS",
                "applicationCategory": "UtilitiesApplication",
                "applicationSubCategory": "Inventory Management",
                "description": metadata_pages.home.description[language],
                "url": `${pageURL}`,
                "inLanguage": ["de", "en", "fr", "it", "rm"],
                "countryOfOrigin": "CH",
                "author": {
                    "@type": "Person",
                    "name": "Marcel Weber",
                    "url": "https://mrweber.ch"
                },
                "publisher": {
                    "@type": "Person",
                    "name": "Marcel Weber",
                    "url": "https://mrweber.ch"
                },
                "offers": {
                    "@type": "Offer",
                    "price": "5.00",
                    "priceCurrency": "CHF"
                },
                "downloadUrl": [
                    "https://play.google.com/store/apps/details?id=com.m00gendai.arsenal",
                    `https://apps.apple.com/app/arsenal-armamentarium/id6670214648`
                ],
                "sameAs": [
                    "https://apps.apple.com/app/arsenal-armamentarium/id6670214648",
                    "https://play.google.com/store/apps/details?id=com.m00gendai.arsenal",
                    "https://www.reddit.com/user/schussfreude/",
                    "https://x.com/Arsenal_App_CH",
                    "https://www.facebook.com/p/Arsenal-Armamentarium-61566434522460/"
                ],
                "featureList": [
                    "100% offline, encrypted local storage",
                    "QuickShot round logging",
                    "QuickStock consumables tracking",
                    "QuickMount accessory linking",
                    "QR code generation and scanning",
                    "Custom PDF report generation",
                    "CSV and full database import/export",
                    "Change history of every collection entry",
                    "Available in German, English, French, Italian and Rumantsch Grischun", 
                    "Country specific functionality for Switzerland, Germany and USA",
                    "Detailed statistics with charts across all collections",
                ],
                ...(userRatingCount && userRatingCount > 0 && {
                    "aggregateRating": {
                        "@type": "AggregateRating",
                        "ratingValue": averageUserRating,
                        "ratingCount": userRatingCount,
                        "bestRating": "5",
                        "worstRating": "1"
                    },
                }),
                "image": `${baseURL}assets/appIcon.png`
            }

const featureImage = `${baseURL}assets/feature_${language}.png`
---

<Layout_Base language={language}>
    <head>
		<meta charset="UTF-8">
        <meta name="viewport"                   content="width=device-width, initial-scale=1.0">
        <meta name="description"                content={pageDescription}>
        <meta name="author"                     content="Marcel Weber">
        <link rel="apple-touch-icon"            sizes="180x180"     href=`${appleTouchIcon.src}`>
        <link rel="icon"                        type="image/png"    sizes="32x32" href=`${favicon32.src}`>
        <link rel="icon"                        type="image/png"    sizes="16x16" href=`${favicon16.src}`>
        <link rel="manifest"                    href="/site.webmanifest">
        <link rel="canonical"                   href=`${pageURL}`>
        {knownKey && languagesList.map(l => (
            <link rel="alternate" hreflang={l} href={`${baseURL}${l}/${metadata_slugs[knownKey][l]}`} />
        ))}
        {knownKey && (
            <link rel="alternate" hreflang="x-default" href={`${baseURL}en/${metadata_slugs[knownKey].en}`} />
        )}
        {noindex && <meta name="robots" content="noindex" />}
        <link rel="sitemap"                     href="/sitemap-index.xml" />
        <title>{pageTitle}</title>
        <meta property="og:title"               content={pageTitle} />
        <meta property="og:description"         content={pageDescription} />
        <meta property="og:locale"              content={ogLocale} />
		{ogAlternates.map(locale => {
            return <meta property="og:locale:alternate" content={locale} />
        })}
        <meta property="og:image"               content=`${featureImage}` />
        <meta property="og:image:alt"           content={metadata_featureImageAlt[language]} />
        <meta property="og:url"                 content=`${pageURL}` />
        <meta property="og:type"                content="website" /><meta property="og:site_name" content="Arsenal App" />
        <meta name="twitter:card"               content="summary_large_image" />
        <meta name="twitter:site"               content="@Arsenal_App_CH" />
        <meta name="twitter:title"              content={pageTitle} />
        <meta name="twitter:description"        content={pageDescription} />
        <meta name="twitter:image"              content={featureImage} />
        <meta name="twitter:image:alt"          content={metadata_featureImageAlt[language]} />
        <meta property="product:price:amount"   content="5.00" />
        <meta property="product:price:currency" content="CHF" />
        {isHome && (
    <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
)}
	</head>
	<body>
        <Navbar language={language} client:load/>
        <main>
		    <slot />
        </main>
		<Footer language={language}/>
	</body>
</Layout_Base>